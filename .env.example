# .env.example - Buni .env nomi bilan saqlang va o'zgartiring

SECRET_KEY=django-insecure-your-very-secret-key-change-this-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL Database
DB_NAME=techblog
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_HOST=localhost
DB_PORT=5432

# Google OAuth (Google Cloud Console'dan olinadi)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Email (zayavka qabul qilinganda xabar yuborish uchun)
# Dev: sozlamasangiz xatlar konsolga chiqadi.
# Production uchun SMTP: EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password_here
DEFAULT_FROM_EMAIL=DataScience <noreply@data-science.uz>
SITE_URL=https://data-science.uz
